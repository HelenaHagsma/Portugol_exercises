programa
{
	
	funcao inicio()
	{
		inteiro a, b, c, d, ee
		escreva("Informe 5 valores: ")
		leia(a, b, c, d, ee)

		//maior
		se(a>b e a>c e a>d e a>ee){
			escreva(a, " é o maior\n")
		}
		se(b>a e b>c e b>d e b>ee){
			escreva(b, " é o maior\n")
		}
		se(c>a e c>b e c>d e c>ee){
			escreva(c, " é o maior\n")
		}
		se(d>a e d>b e d>c e d>ee){
			escreva(d, " é o maior\n")
		}
		se(ee>a e ee>b e ee>c e ee>d){
			escreva(ee, " é o maior\n")
		}

		//menor
		se(a<b e a<c e a<d e a<ee){
			escreva(a, " é o menor\n")
		}
		se(b<a e b<c e b<d e b<ee){
			escreva(b, " é o menor\n")
		}
		se(c<a e c<b e c<d e c<ee){
			escreva(c, " é o menor\n")
		}
		se(d<a e d<b e d<c e d<ee){
			escreva(d, " é o menor\n")
		}
		se(ee<a e ee<b e ee<c e ee<d){
			escreva(ee, " é o menor\n")
		}
	}
}
