programa
{
	
	funcao inicio()
	{
		real n1, n2, r
		escreva("Informe o primeiro numero: ")
		leia(n1)
		escreva("Informe o segundo numero: ")
		leia(n2)

		r = n1 / n2

		escreva("O resultado da divisão é: ", r)
	}
}
