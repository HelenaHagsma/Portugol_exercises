programa
{
	
	funcao inicio()
	{
		inteiro n, tab1, tab2, tab3, tab4, tab5, tab6, tab7, tab8, tab9, tab10
		escreva("Informe um número: ")
		leia(n)

		tab1 = n * 1
		tab2 = n * 2
		tab3 = n * 3
		tab4 = n * 4
		tab5 = n * 5
		tab6 = n * 6
		tab7 = n * 7
		tab8 = n * 8
		tab9 = n * 9
		tab10 = n * 10

		escreva("A tabuada do número ", n, " é: ")
		escreva("\n1 x ", n, " = ", tab1)
		escreva("\n2 x ", n, " = ", tab2)
		escreva("\n3 x ", n, " = ", tab3)
		escreva("\n4 x ", n, " = ", tab4)
		escreva("\n5 x ", n, " = ", tab5)
		escreva("\n6 x ", n, " = ", tab6)
		escreva("\n7 x ", n, " = ", tab7)
		escreva("\n8 x ", n, " = ", tab8)
		escreva("\n9 x ", n, " = ", tab9)
		escreva("\n10 x ", n, " = ", tab10)
	}
}
