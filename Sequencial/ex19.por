programa
{
	
	funcao inicio()
	{
		inteiro qnt, valor
		escreva("Informe a quantidade de frangos na granja: ")
		leia(qnt)

		valor = qnt * 11

		escreva("O valor necessario para equipar todos os frangos com aneis de identificação e de alimentação é: R$", valor)
	}
}
