programa
{
	
	funcao inicio()
	{
		real n1, n2, media
		escreva("Informe a primeira nota: ")
		leia(n1)
		escreva("Informe a segunda nota: ")
		leia(n2)

		media = ((n1*2) + (n2*3))/ 5

		escreva("A média ponderada é: ", media)
	}
}
