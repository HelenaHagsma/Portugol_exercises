programa
{
	
	funcao inicio()
	{
		real altura, bmai, bmen, area
		escreva("Informe a altura do trapezio: ")
		leia(altura)
		escreva("Informe a base menor do trapezio: ")
		leia(bmen)
		escreva("Informe a base maior do trapezio: ")
		leia(bmai)

		area = ((bmai + bmen) * altura)/2

		escreva("A area do trapezio é: ", area)
		
	}
}
