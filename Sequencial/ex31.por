programa
{
	
	funcao inicio()
	{
		real peso, eng, ema
		escreva("Informe o seu peso: ")
		leia(peso)

		eng = peso * 1.15
		ema = peso * 0.80

		escreva("Seu peso acrescentado de 15% é: ", eng, "kg.")
		escreva("\nSeu peso subtraido de 20% é: ", ema, "kg.")
		
	}
}
