programa
{
	
	funcao inicio()
	{
		inteiro n1, n2, n3, r
		escreva("Informe o primeiro numero: ")
		leia(n1)
		escreva("Informe o segundo numero: ")
		leia(n2)
		escreva("Informe o terceiro numero: ")
		leia(n3)

		r = n1 * n2 * n3

		escreva("O resultado da multiplicação é : ", r)
	}
}
