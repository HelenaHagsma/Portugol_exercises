programa
{
	
	funcao inicio()
	{
		real dmen, dmai, area
		escreva("Informe a diagonal menor do losango: ")
		leia(dmen)
		escreva("Informe a diagonal maior do losango: ")
		leia(dmai)

		area = (dmai * dmen)/2

		escreva("A area do losango é: ", area)
	}
}
