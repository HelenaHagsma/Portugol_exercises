programa
{
	
	funcao inicio()
	{
		real litros, agua, suco
		escreva("Informe quantos litros de refresco deseja fazer: ")
		leia(litros)

		agua = litros * 0.8
		suco = litros * 0.2

		escreva("Serão necessários ", agua ,"L de água, e ", suco,"L de suco.")
	}
}
