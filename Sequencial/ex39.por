programa
{
	
	funcao inicio()
	{
		real sal = 1200, c1 = 200, c2= 120, salfinal

		c1 = c1 * 1.02
		c2 = c2 * 1.02
		salfinal = sal - c1 - c2

		escreva("O salario final de João é: R$", salfinal)
	}
}
