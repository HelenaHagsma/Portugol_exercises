programa
{
	
	funcao inicio()
	{
		inteiro qnt, kgq, kgp, kgh
		escreva("Informe a quantidade de sanduiches a fazer: ")
		leia(qnt)

		kgq = qnt * 0.1
		kgp = qnt * 0.050
		kgh = qnt * 0.1

		escreva("A quantidade de kilos de queijo necessarios é: ", kgq)
		escreva("\nA quantidade de kilos de presunto necessarios é: ", kgp)
		escreva("\nA quantidade de kilos de hamburguer necessarios é: ", kgh)
		
	}
}
