programa
{
	
	funcao inicio()
	{
		inteiro salmin, sal, calc
		escreva("Informe o valor do salario minimo: ")
		leia(salmin)
		escreva("Informe o seu salario: ")
		leia(sal)

		calc = sal / salmin

		escreva("Voce recebe ", calc, " salarios minimos. ")
	}
}
